@page "/pos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Վաճառքի դրամարկղ</PageTitle>
<RetailHeader Title="Վաճառքի դրամարկղ" CurrentPage="pos" />
<main id="main-content" tabindex="-1" class="wrap editor">
    @if (error is not null)
    {
        <p role="alert" class="notice error">@error</p>
    }
    @if (notice is not null)
    {
        <p role="status" class="notice success">@notice</p>
    }
    <section class="card">
        <h2>Ավելացնել ապրանք</h2>
        <form @onsubmit="ScanAsync" @onsubmit:preventDefault>
            <label for="pos-scan">Շտրիխկոդ կամ Data Matrix</label>
            <input id="pos-scan" @ref="scanInput" autocomplete="off" spellcheck="false" @bind="scan" @bind:event="oninput" disabled="@Locked" required />
            <button disabled="@Locked">Ավելացնել սկանով</button>
        </form>
        <form @onsubmit="AddSelected" @onsubmit:preventDefault>
            <label for="pos-product">Ընտրել ապրանք ցանկից</label>
            <select id="pos-product" @bind="selectedId" @bind:after="SelectAsync" required disabled="@Locked">
                <option value="">Ընտրիր ապրանքը</option>
                @foreach (var product in products)
                {
                    <option value="@product.Id">@product.Name (@product.Sku)</option>
                }
            </select>
            @if (profile?.RequiresMarking == true)
            {
                <label for="pos-codes">Data Matrix կոդեր՝ յուրաքանչյուր միավորը առանձին տողում</label>
                <textarea id="pos-codes" class="marking-scans" rows="3" @bind="codes" disabled="@Locked" spellcheck="false" required></textarea>
            }
            else
            {
                <label for="pos-quantity">Քանակ</label>
                <input id="pos-quantity" type="number" step="0.001" min="0.001" max="1000000" @bind="quantity" disabled="@Locked" required />
            }
            <button type="submit" disabled="@(Locked || profile is null)">Ավելացնել զամբյուղում</button>
        </form>
    </section>
    <section id="pos" class="card pos-cart">
        <h2>Վաճառքի զամբյուղ</h2>
        @if (cart.Count == 0)
        {
            <p>Զամբյուղը դատարկ է։</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="cart-lines">
                    <thead><tr><th scope="col">Ապրանք</th><th scope="col">Քանակ</th><th scope="col">Միավորի գին</th><th scope="col">Գումար</th><th scope="col">Գործողություն</th></tr></thead>
                    <tbody>
                        @foreach (var line in cart)
                        {
                            <tr @key="line.Product.Id">
                                <td>@line.Product.Name @if (line.Codes.Length > 0) { <small>(Data Matrix՝ @line.Codes.Length)</small> }</td>
                                <td>@line.Quantity.ToString("0.###")</td><td>@line.Product.UnitPriceAmd ֏</td><td>@line.Total ֏</td>
                                <td><button type="button" class="secondary" aria-label="@($"Հեռացնել {line.Product.Name}")" @onclick="() => Remove(line)" disabled="@Locked">Հեռացնել</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="cart-summary">
                <strong>Ընդամենը՝ @cart.Sum(line => line.Total) ֏</strong>
                <button id="pos-checkout" type="button" @onclick="CheckoutAsync" disabled="@busy">@(pendingId.HasValue ? "Ստուգել վաճառքի հաստատումը" : "Գրանցել վաճառքը")</button>
            </div>
        }
    </section>
    @if (receipt is not null)
    {
        <section class="card">
            <h2>Վերջին գրանցված վաճառքը</h2>
            <p>Վաճառքի ID՝ @receipt.Id<br />Ընդհանուր գումար՝ @receipt.TotalAmd ֏</p>
            <details>
                <summary>Վաճառքի տողեր և վերադարձի ID-ներ</summary>
                <ul>
                    @foreach (var line in receipt.Lines)
                    {
                        <li>@ProductName(line.ProductId) · @line.Quantity.ToString("0.###") · @line.TotalAmd ֏ · @line.Id</li>
                    }
                </ul>
            </details>
        </section>
    }
</main>
